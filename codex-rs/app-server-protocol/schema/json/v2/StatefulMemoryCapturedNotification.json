{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "StatefulMemoryReceipt": {
      "description": "A committed (or refused) memory capture, Apply or Undo. Counts are by member status: saved rules are not proposals, and a refusal never reports a save.",
      "properties": {
        "kind": {
          "$ref": "#/definitions/StatefulMemoryReceiptKind"
        },
        "members": {
          "description": "At most 24.",
          "items": {
            "$ref": "#/definitions/StatefulMemoryReceiptMember"
          },
          "type": "array"
        },
        "projectId": {
          "type": "string"
        },
        "receiptId": {
          "description": "Pass to `statefulMemory/undo`.",
          "type": "string"
        },
        "threadId": {
          "type": "string"
        },
        "turnId": {
          "type": [
            "string",
            "null"
          ]
        },
        "undoable": {
          "description": "Whether one Undo can reverse what this receipt saved or proposed.",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "members",
        "projectId",
        "receiptId",
        "threadId",
        "undoable"
      ],
      "type": "object"
    },
    "StatefulMemoryReceiptCategory": {
      "description": "The kind of knowledge a receipt member holds.",
      "enum": [
        "rule",
        "background",
        "attributedContext",
        "decision",
        "brainstormOption",
        "ruledOut",
        "openCheck",
        "note",
        "other"
      ],
      "type": "string"
    },
    "StatefulMemoryReceiptKind": {
      "description": "What a memory receipt reports.",
      "oneOf": [
        {
          "description": "Standing project rules the user stated in a supported declaration.",
          "enum": [
            "rules"
          ],
          "type": "string"
        },
        {
          "description": "Material kept for review; nothing was applied.",
          "enum": [
            "proposals"
          ],
          "type": "string"
        },
        {
          "description": "A proposal the user applied.",
          "enum": [
            "promotion"
          ],
          "type": "string"
        },
        {
          "description": "A receipt the user undid.",
          "enum": [
            "undo"
          ],
          "type": "string"
        }
      ]
    },
    "StatefulMemoryReceiptMember": {
      "description": "One unit of a memory receipt.",
      "properties": {
        "category": {
          "$ref": "#/definitions/StatefulMemoryReceiptCategory"
        },
        "entryId": {
          "description": "Absent when nothing was stored for this unit.",
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "status": {
          "$ref": "#/definitions/StatefulMemoryReceiptStatus"
        },
        "text": {
          "description": "At most 240 bytes. For proposals this is the assistant's labelled reading, not the user's words; applied and stated entries show the user's exact words.",
          "type": "string"
        },
        "textShortened": {
          "description": "Whether `text` is shorter than the stored words.",
          "type": "boolean"
        }
      },
      "required": [
        "category",
        "status",
        "text",
        "textShortened"
      ],
      "type": "object"
    },
    "StatefulMemoryReceiptStatus": {
      "description": "What became of one unit of a receipt.",
      "oneOf": [
        {
          "enum": [
            "saved",
            "alreadyPresent"
          ],
          "type": "string"
        },
        {
          "description": "Kept for review, not applied.",
          "enum": [
            "proposed"
          ],
          "type": "string"
        },
        {
          "description": "Kept, not applied, with an unresolved dependency.",
          "enum": [
            "pending"
          ],
          "type": "string"
        },
        {
          "description": "Recognized but not stored whole; the exact source remains.",
          "enum": [
            "omitted"
          ],
          "type": "string"
        },
        {
          "description": "Words the user forgot earlier; a later statement does not restore them.",
          "enum": [
            "notRestored"
          ],
          "type": "string"
        },
        {
          "description": "Held back with the rest of a refused declaration.",
          "enum": [
            "refused"
          ],
          "type": "string"
        },
        {
          "description": "Retired by an Undo.",
          "enum": [
            "undone"
          ],
          "type": "string"
        },
        {
          "description": "An Undo returned an applied proposal to review.",
          "enum": [
            "proposalRestored"
          ],
          "type": "string"
        },
        {
          "description": "Existed before the undone receipt; left as it was.",
          "enum": [
            "untouched"
          ],
          "type": "string"
        }
      ]
    }
  },
  "description": "Sent when a turn's words were captured, or a capture was refused, or the user applied a proposal or undid a receipt.",
  "properties": {
    "receipt": {
      "$ref": "#/definitions/StatefulMemoryReceipt"
    }
  },
  "required": [
    "receipt"
  ],
  "title": "StatefulMemoryCapturedNotification",
  "type": "object"
}
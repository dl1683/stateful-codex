load("//:defs.bzl", "codex_rust_crate")

codex_rust_crate(
    name = "stateful-runtime",
    compile_data = glob([
        "migrations/**",
        "project_migrations/**",
        "tests/data/**",
    ]),
    crate_name = "codex_stateful_runtime",
)

filegroup(
    name = "migration-history-test-data",
    srcs = glob([
        "migrations/**",
        "tests/data/**",
    ]),
    visibility = ["//codex-rs/app-server:__pkg__"],
)

filegroup(
    name = "project-store-migrations",
    srcs = glob(["migrations/**"]),
    visibility = [
        "//codex-rs/ext/stateful:__pkg__",
        "//codex-rs/stateful-memory:__pkg__",
    ],
)

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "id", "kind", "surface", "principles", "fixture", "conversation", "capture", "grading", "tiers"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^surface\\.tui\\.[a-z0-9-]+$"},
    "kind": {"const": "surface"},
    "surface": {"const": "tui"},
    "arms": {"type": "array", "items": {"enum": ["base", "stateful"]}, "minItems": 2, "uniqueItems": true},
    "principles": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "fixture": {
      "type": "object",
      "required": ["type", "source", "sha256", "writable", "private"],
      "properties": {
        "type": {"enum": ["repo-fixture", "pinned-git", "external"]},
        "source": {"type": "string", "minLength": 1},
        "sourceUrl": {"type": "string"},
        "revision": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "writable": {"const": true},
        "private": {"type": "boolean"}
      }
    },
    "conversation": {
      "type": "object",
      "required": ["mode", "initialMessage", "turns", "approvalPolicy", "turnTimeoutSeconds", "idleStableSeconds"],
      "properties": {
        "mode": {"enum": ["autonomous", "collaborative", "socratic"]},
        "initialMessage": {"type": "string", "minLength": 1},
        "turns": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "approvalPolicy": {"const": "auto"},
        "turnTimeoutSeconds": {"type": "integer", "minimum": 1},
        "idleStableSeconds": {"type": "integer", "minimum": 1}
      }
    },
    "capture": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "grading": {
      "type": "object",
      "required": ["adapter", "observations"],
      "properties": {"adapter": {"const": "tui-evidence"}, "observations": {"type": "array", "items": {"type": "string"}, "minItems": 1}}
    },
    "tiers": {"type": "array", "items": {"enum": ["surface", "smoke", "full"]}, "minItems": 1}
  }
}

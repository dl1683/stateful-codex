ARG BIXBENCH_BASE_IMAGE=stateful-bixbench-env:fhda-v1.5.0-amd64
FROM ${BIXBENCH_BASE_IMAGE}

# Official-comparison builds should supply the environment rebuilt from
# FutureHouse's pinned v1.5.0 Dockerfile. Directional runs may explicitly use a
# compatible base and must record it as non-official. Pinning the Excel reader
# here is redundant for the full upstream image but repairs truncated debug bases.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
        jq \
        ripgrep && \
    rm -rf /var/lib/apt/lists/* && \
    python -m pip install --no-cache-dir openpyxl==3.1.5

WORKDIR /workspace

{
  "name": "SC-EVAL-024 source-change and compaction canary",
  "model": "gpt-5.6-luna",
  "reasoningEffort": "high",
  "mode": "autonomous",
  "memoryPolicy": "disabled",
  "compaction": {
    "autoCompactTokenLimit": 20000
  },
  "requiredObservations": {
    "baseline": ["quality", "sourceAudit"],
    "stateful": ["quality", "sourceAudit", "state"]
  },
  "projects": [
    {
      "id": "source-change-canary",
      "selectionRole": "diagnosticCanary",
      "domain": "policy revision and durable correction",
      "isolatedCopies": true,
      "requireStatefulProjectState": true,
      "requireDurableCompletion": true,
      "source": {
        "project": "source-change-canary",
        "roots": ["."]
      },
      "cases": [
        {
          "id": "learn-v1",
          "prompt": "Using only this selected project, determine whether launch is currently permitted. Identify the controlling source, calculate the answer from the measured value, preserve the consequential conclusion and exact evidence for later work, and cite exact files and lines. Do not edit files.",
          "expectedConcepts": [
            {"name": "v1-threshold", "termGroups": [["10"], ["8"], ["permitted"]]}
          ],
          "forbiddenPhrases": ["6 or fewer"]
        },
        {
          "id": "revise-v2",
          "prompt": "The project sources may have changed. Re-verify the controlling policy against the raw source, reassess the launch decision, and explicitly repair any durable conclusion that the new evidence supersedes while retaining truthful historical provenance. Cite exact files and lines. Do not edit files.",
          "intervention": {
            "id": "executed-policy-v2",
            "expectedBeforeCorpusRevision": "sha256:76b06b36598980d77f68bb13de24cce31acaa67f2fbcb1ec0dfb93ba08e3d51c",
            "expectedAfterCorpusRevision": "sha256:6512ebca2135a80e68f1bffb304dae700c06aab3c4f5596735fcebdfd9ca4b64",
            "files": [
              {
                "path": "policy.md",
                "replacement": "../revisions/source-change-canary/policy-v2.md",
                "expectedBeforeSha256": "13ee5c9e737f79323a04cf6cc7fef651c6fa58f6b332605a2e96ee55c514d230",
                "replacementSha256": "e50d744d872b7f1ea2425dfeaeaca0a0dd794062dc4a590b3e83a493e8b906e1"
              }
            ]
          },
          "expectedConcepts": [
            {"name": "v2-threshold", "termGroups": [["6"], ["8"], ["not permitted"]]},
            {"name": "supersession", "termGroups": [["replaces", "supersedes", "superseded"]]}
          ],
          "forbiddenPhrases": ["launch is permitted"]
        },
        {
          "id": "reconcile",
          "prompt": "Explain the complete decision history now: what the prior policy established, what changed, which conclusion is current, and how the preserved evidence should distinguish historical support from current support. Use project state first and verify only the exact source regions needed. Do not edit files.",
          "expectedConcepts": [
            {"name": "historical-current-distinction", "termGroups": [["10"], ["6"], ["historical"], ["current"]]},
            {"name": "current-decision", "termGroups": [["8"], ["not permitted"]]}
          ],
          "forbiddenPhrases": []
        },
        {
          "id": "post-compaction-recall",
          "prompt": "Without broadly rereading the project, state the current launch decision, the exact controlling threshold and measured count, and the superseded threshold. Verify the controlling lines if needed and cite them. Do not edit files.",
          "expectedConcepts": [
            {"name": "post-compaction-current", "termGroups": [["6"], ["8"], ["not permitted"], ["10"]]}
          ],
          "forbiddenPhrases": ["launch is permitted"]
        }
      ]
    }
  ]
}
